---
import '@fontsource-variable/dm-sans';
import '../styles/landing.css';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es" data-view="inst">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Página no encontrada · HaNet</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <main class="wrap hero">
    <h1 class="h2">Esta página no existe.</h1>
    <p class="lead">Puede que el link esté mal escrito o que la página se haya movido.</p>
    <div class="actions" style="margin-top: 32px">
      <a class="btn btn--pink" href={base}>Ir al inicio</a>
    </div>
  </main>
</body>
</html>
