---
import '@fontsource-variable/dm-sans';
import '../styles/landing.css';
import Phone from '../components/Phone.astro';
import HeroTitle from '../components/react/HeroTitle';
import Marquee from '../components/react/Marquee';
import ScratchCard from '../components/react/ScratchCard';
import changelog from '../data/changelog.json';
import {
  APP_URL, AUDS, DAY, DOCS_URL, EMAIL, GITHUB_URL, HERO, NAV, PANEL_URL, PASOS, ROLES, SITE_URL, STATUS_URL, SWAPS, TERMS_URL, TITLES, TOUR,
  type Aud, type Screen,
} from '../data/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const auds: Aud[] = ['inst', 'est'];
const screens = TOUR.map(t => t.key) as Screen[];
const releases = changelog.releases.slice(0, 5);
const current = releases[0]?.version ?? '';
const short = (v: string) => v.replace(/-beta$/, '');
const fmtDate = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('es-CL', { day: 'numeric', month: 'short' }).replace('.', '');
const description = 'HaNet es la app de las instituciones educativas chilenas: horario, Calendar del curso, clases, notas, eventos y alianzas en un mismo lugar. Para estudiantes, docentes y equipos directivos.';
const logo = 'M5.02344 40.8102V2.18981V0L15.3522 9.55556V19.5093L20.5166 20.1065V13.338L34.0234 14.5324V16.7222V26.2778V28.4676L20.5166 29.662V22.8935L15.3522 23.4907V33.4444L5.02344 43V40.8102Z';
const arrow = 'M7 17L17 7M9 7h8v8';
---
<!doctype html>
<html lang="es" data-view="inst">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>HaNet · Toda tu institución, en una sola app</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#282829" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="canonical" href={SITE_URL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:title" content="HaNet · Toda tu institución, en una sola app" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={SITE_URL} />
  <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>
    // La vista se decide antes de pintar: #estudiantes manda; si no, la que la
    // persona eligió la primera vez (guardada en este navegador). Sin elección
    // todavía, la página pregunta (clase "asking").
    (function () {
      var root = document.documentElement;
      root.classList.add('js');
      var saved = null;
      try { saved = localStorage.getItem('hanet.landing.perfil'); } catch (e) { /* sin almacenamiento */ }
      if (location.hash === '#estudiantes') root.dataset.view = 'est';
      else if (saved === 'est' || saved === 'inst') root.dataset.view = saved;
      else root.classList.add('asking');
    })();
  </script>
</head>
<body>
<div class="ambient" aria-hidden="true"><span></span><span></span></div>
<a class="skip" href="#contenido">Ir al contenido</a>

<!-- Primera visita: ¿quién eres? -->
<dialog class="ask" data-ask tabindex="-1" aria-labelledby="ask-title" aria-describedby="ask-text">
  <svg class="ask__mark" width="26" height="36" viewBox="4 0 31 43" aria-hidden="true"><path d={logo} fill="#EF2274"></path></svg>
  <h2 class="ask__title" id="ask-title">¡Hola! ¿Quién eres?</h2>
  <p class="ask__text" id="ask-text">Te mostramos lo que te sirve. Puedes cambiarlo cuando quieras.</p>
  <div class="ask__options">
    <button type="button" class="ask__opt" data-answer="inst">
      <span class="ask__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V9.5L12 5l7 4.5V21M9.5 21v-5h5v5M9 12h.01M15 12h.01"></path></svg></span>
      <span class="ask__label"><span class="ask__name">Soy de la administración</span><span class="ask__sub">Quiero HaNet para mi institución</span></span>
    </button>
    <button type="button" class="ask__opt" data-answer="est">
      <span class="ask__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 9L12 4.5 21.5 9 12 13.5z"></path><path d="M6.5 11v4.5c1.5 1.5 3.4 2.2 5.5 2.2s4-.7 5.5-2.2V11M21.5 9v5.5"></path></svg></span>
      <span class="ask__label"><span class="ask__name">Soy estudiante</span><span class="ask__sub">Quiero entrar a HaNet</span></span>
    </button>
  </div>
  <button type="button" class="ask__skip" data-answer="skip">Solo estoy mirando</button>
</dialog>

<header class="wrap top">
  <a href="#inicio" class="brand" aria-label="HaNet, inicio">
    <svg width="22" height="30" viewBox="4 0 31 43" aria-hidden="true"><path d={logo} fill="#EF2274"></path></svg>
    <span class="brand__name">HaNet</span>
    <span class="pill pill--quiet">Beta</span>
  </a>
  {auds.map(a => (
    <nav class="top__nav" aria-label="Secciones" data-aud={a}>
      {NAV[a].map(n => <a href={n.href}>{n.label}</a>)}
    </nav>
  ))}
  <a class="btn btn--light btn--icon" href={APP_URL}>Abrir HaNet
    <span class="btn__dot"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg></span>
  </a>
</header>

<main id="contenido">
<!-- Hero -->
<section id="inicio" class="wrap hero">
  <div class="seg" role="group" aria-label="Elige tu vista">
    {AUDS.map(a => <button type="button" class="seg__btn" data-pick={a.id} aria-pressed={a.id === 'inst' ? 'true' : 'false'}>{a.name}</button>)}
  </div>
  <HeroTitle client:load titles={TITLES} />
  {auds.map(a => (
    <div class="hero__row" data-aud={a}>
      <p class="hero__sub">{HERO[a].sub}</p>
      <div class="actions">
        <a class="btn btn--pink btn--icon" href={HERO[a].mainHref}>{HERO[a].main}
          <span class="btn__dot"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg></span>
        </a>
        <a class="btn btn--line" href={HERO[a].otherHref}>{HERO[a].other}</a>
      </div>
    </div>
  ))}
  <p class="fine">En beta en el Liceo Camilo Henríquez de Temuco · iPhone, Android y web</p>

  <!-- El día que avanza -->
  <div class="day" data-day>
    <div class="day__list">
      <span class="day__label">Hoy · jueves 20 de noviembre</span>
      <div class="day__window">
        <ol class="day__rows" data-rows>
          {DAY.map(b => (
            <li class:list={['day__row', { 'day__row--pause': b.pause }]}>
              <span class="day__time">{b.t}</span>
              <span class="day__subject">{b.s}</span>
              {b.test && <span class="pill pill--test"><span class="dot"></span>Prueba</span>}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="day__side">
      <div class="now" aria-live="off">
        <div class="now__head"><span data-now-label>Ahora en clases</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V6.5A2.5 2.5 0 0 1 6.5 4H20v13H6.5A2.5 2.5 0 0 0 4 19.5 2.5 2.5 0 0 0 6.5 22H20"></path></svg>
        </div>
        <div class="now__subject" data-now-subject>{DAY[3].s}</div>
        <div class="now__where" data-now-where>{DAY[3].where}</div>
        <div class="now__bar"><div data-now-bar></div></div>
        <div class="now__times"><span data-now-start>{DAY[3].t}</span><span data-now-end>{DAY[3].end}</span></div>
      </div>
      <div class="tile">
        <span class="tile__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="3"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg></span>
        <div><div class="tile__small">Próxima evaluación</div><div class="tile__big">Prueba de Química · hoy, 10:30</div></div>
      </div>
      <div class="tile tile--split">
        <div class="tile__big">Calificaciones</div>
        <span class="pill pill--stripes">2 notas nuevas</span>
      </div>
    </div>
  </div>
</section>

<!-- Cinta de módulos -->
<Marquee client:visible rows={[['Calendar', 'ClassHall', 'Eventos', 'Notas', 'Alianzas'], ['Feed', 'Entradas', 'Herramientas', 'HaNet ID', 'Horario']]} />

<!-- Antes y con HaNet -->
<section class="wrap section">
  <p class="kicker"><span class="kicker__n">01</span>Sin caos</p>
  <h2 class="h2">Menos grupos, menos papeles, menos apps.</h2>
  {auds.map(a => (
    <ul class="swaps" data-aud={a}>
      {SWAPS[a].map(s => (
        <li class="swap">
          <span class="swap__before"><span class="sr">Antes: </span>{s.before}</span>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          <span class="swap__after"><span class="sr">Con HaNet: </span>{s.after}</span>
        </li>
      ))}
    </ul>
  ))}
</section>

<!-- Recorrido por los módulos -->
<section id="modulos" class="wrap section tour" data-tour>
  <p class="kicker tour__kicker"><span class="kicker__n">02</span>Módulos</p>
  {auds.map(a => (
    <div class="tour__mhead" data-aud={a}>
      <h2 class="h2">{TOUR[0].head?.[a]}</h2>
    </div>
  ))}
  <div class="tour__steps" data-carousel>
    {TOUR.map((t, i) => (
      <article class="step" data-step={i} data-key={t.key} data-theme={t.key}>
        {auds.map(a => t.head?.[a] && (
          <div class="step__head" data-aud={a}>
            <h2 class="h2">{t.head[a]}</h2>
            {t.headText?.[a] && <p class="lead">{t.headText[a]}</p>}
          </div>
        ))}
        <div class="step__body">
          <span class="pill pill--quiet">{t.tag}</span>
          <h3 class="step__name">{t.name}</h3>
          {t.sub && <p class="step__sub">{t.sub}</p>}
          {auds.map(a => <p class="step__text" data-aud={a}>{t.text[a]}</p>)}
          <div class="step__phone">
            <Phone screens={[t.key]} active={t.key} class="phone--step" />
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="tour__aside" aria-hidden="true">
    <div class="tour__sticky">
      <div class="tilt" data-tilt><Phone screens={screens} active="calendar" eager class="phone--tour" /></div>
      <div class="dots">{TOUR.map((_, i) => <span data-dot={i}></span>)}</div>
    </div>
  </div>
</section>
<div class="wrap carousel-hint" aria-hidden="true"><span>Desliza para explorar</span><div class="dots dots--m">{TOUR.map((_, i) => <span data-mdot={i}></span>)}</div></div>
<p class="wrap fine" data-aud="inst">Próximamente: Notebook, el libro de clases digital, después de la beta.</p>

<!-- Raspar una nota -->
<section class="wrap section scratch-section">
  <div class="scratch-section__text">
    <p class="kicker"><span class="kicker__n">03</span>Notas</p>
    <h2 class="h2" data-aud="inst">Así reciben sus notas tus estudiantes.</h2>
    <h2 class="h2" data-aud="est">Tu nota llega tapada. Ráspala.</h2>
    <p class="lead" data-aud="inst">Cada nota llega tapada y se destapa en pantalla completa, con el dedo. Pruébalo aquí mismo.</p>
    <p class="lead" data-aud="est">Cuando tu docente publica una nota, te llega un aviso que nunca la muestra. La destapas tú, con el dedo. Pruébalo aquí mismo.</p>
  </div>
  <ScratchCard client:visible subject="Lenguaje y Literatura" title="Ensayo argumentativo" date="16 de noviembre" grade="6,7" />
</section>

<!-- Para cada rol (vista inst) -->
<section class="wrap section" data-aud="inst">
  <p class="kicker"><span class="kicker__n">04</span>Roles</p>
  <h2 class="h2">Cada rol ve lo suyo.</h2>
  <div class="seg seg--scroll" role="tablist" aria-label="Roles">
    {ROLES.map((r, i) => (
      <button type="button" class="seg__btn" role="tab" id={`rol-${i}`} aria-controls={`rol-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-role={i}>{r.name}</button>
    ))}
  </div>
  {ROLES.map((r, i) => (
    <div class="role" role="tabpanel" id={`rol-panel-${i}`} aria-labelledby={`rol-${i}`} hidden={i !== 0}>
      <p class="role__intro">{r.intro}</p>
      <ul class="role__grid">
        {r.items.map(it => (
          <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>{it}</li>
        ))}
      </ul>
    </div>
  ))}
</section>

<!-- Cómo empezar -->
<section id="empezar" class="wrap section">
  {auds.map(a => (
    <div class="card start" data-aud={a}>
      <svg class="start__mark" viewBox="4 0 31 43" aria-hidden="true"><path d={logo} fill="#EF2274"></path></svg>
      <p class="kicker"><span class="kicker__n">{a === 'inst' ? '05' : '04'}</span>{a === 'inst' ? 'Cómo empezar' : 'Crear cuenta'}</p>
      <h2 class="h2">{PASOS[a].title}</h2>
      <p class="lead">{PASOS[a].text}</p>
      <ol class="steps" data-steps>
        {PASOS[a].steps.map((s, i) => (
          <li><span class="steps__n">{PASOS[a].labels[i]}</span><span class="steps__t">{s}</span></li>
        ))}
      </ol>
      <div class="actions">
        <a class="btn btn--light" href={PASOS[a].mainHref}>{PASOS[a].main}</a>
        <a class="btn btn--line" href={PASOS[a].otherHref}>{PASOS[a].other}</a>
      </div>
      <p class="fine">{PASOS[a].foot}</p>
    </div>
  ))}
</section>

<!-- Contribuir y novedades -->
<section id="novedades" class="wrap section news">
  <div class="news__text">
    <p class="kicker"><span class="kicker__n" data-aud="inst">06</span><span class="kicker__n" data-aud="est">05</span>Open source</p>
    <h2 class="h2">Contribuye al proyecto HaNet.</h2>
    <p class="lead">¿Tienes ideas, quejas o encontraste algún error? ¡Avísanos!<br />Entre todos hacemos de HaNet la mejor herramienta open source para la educación. Contribuye en GitHub o por correo.</p>
    <div class="chips">
      <a class="chip" href={GITHUB_URL}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>Código en GitHub</a>
      <a class="chip" href={`mailto:${EMAIL}?subject=${encodeURIComponent('Sugerencia para HaNet')}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M4 7l8 6 8-6"></path></svg>Enviar una sugerencia</a>
    </div>
  </div>
  <div class="card releases">
    <div class="releases__head">
      <span class="releases__logo"><svg width="20" height="28" viewBox="4 0 31 43" aria-hidden="true"><path d={logo} fill="#EF2274"></path></svg></span>
      <div><h3 class="releases__title">Novedades</h3><div class="releases__sub">Versión actual: {current}</div></div>
    </div>
    <ul class="releases__list">
      {releases.map(r => (
        <li><span class="releases__v">{short(r.version)}</span><span class="releases__name">{r.title}</span><span class="releases__date">{fmtDate(r.date)}</span></li>
      ))}
    </ul>
  </div>
</section>

<!-- Para instituciones -->
<section id="instituciones" class="wrap section">
  <div class="card card--pink cta" data-aud="inst">
    <div class="cta__main">
      <h2 class="h2">¿Quieres HaNet en tu institución?</h2>
      <p class="cta__text">Haz que tu institución sea parte de HaNet beta por un precio reducido, con todos los módulos incluidos. Escríbenos a este correo.</p>
      <div class="mail">
        <a class="mail__addr" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <button type="button" class="mail__copy" data-copy={EMAIL} data-done="Correo copiado">Copiar correo</button>
      </div>
    </div>
    <ul class="cta__list">
      <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>Base de datos en Santiago de Chile, con una tasa de caídas casi nula.</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6z"></path></svg>Sistema seguro y cerrado: solo entran tu institución y tus estudiantes.</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="2"></rect><rect x="13" y="4" width="7" height="7" rx="2"></rect><rect x="4" y="13" width="7" height="7" rx="2"></rect><rect x="13" y="13" width="7" height="7" rx="2"></rect></svg>Disponible para iPhone, Android y navegadores.</li>
    </ul>
  </div>
  <div class="card card--pink cta" data-aud="est">
    <div class="cta__main">
      <h2 class="h2">¿Tu institución todavía no usa HaNet?</h2>
      <p class="cta__text">¡Pídelo! Muéstrale esta página a tu profe jefe, al CEE o a la dirección. Cuando tu institución se sume, entras con su código.</p>
      <div class="actions">
        <button type="button" class="btn btn--dark" data-copy={SITE_URL} data-done="Link copiado">Copiar el link</button>
        <button type="button" class="btn btn--line-dark" data-pick="inst" data-top>Ver la página para instituciones</button>
      </div>
    </div>
    <ul class="cta__list">
      <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6z"></path></svg>Sin chats ni seguidores: HaNet es solo para tu institución.</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.5"></rect><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"></path></svg>Protege tus notas con Face ID o tu huella, si quieres.</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5a14 14 0 0 1 18 0M6.5 13a9 9 0 0 1 11 0M10 16.5a4 4 0 0 1 4 0"></path><circle cx="12" cy="20" r="0.8" fill="currentColor"></circle></svg>Tu horario y tu Calendar se abren aunque no tengas internet.</li>
    </ul>
  </div>
</section>
</main>

<footer class="wrap foot">
  <div class="foot__main">
    <div class="brand"><svg width="18" height="25" viewBox="4 0 31 43" aria-hidden="true"><path d={logo} fill="#EF2274"></path></svg><span class="brand__name">HaNet</span></div>
    <p>Preguntas o sugerencias: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    <p class="fine">© 2026 HaNet · Hecho en Chile</p>
    <p class="fine">HaNet es un proyecto independiente y open source. No está afiliado al Mineduc ni a ninguna institución de la red HaNet.</p>
  </div>
  <nav class="foot__nav" aria-label="Pie de página">
    <a href={APP_URL}>Abrir HaNet</a>
    <a href={PANEL_URL}>Panel para instituciones</a>
    <a href={DOCS_URL}>Documentación</a>
    <a href="#novedades">Novedades</a>
    <a href={STATUS_URL}>Estado de HaNet</a>
    <a href={TERMS_URL}>Términos y privacidad</a>
    <a href={GITHUB_URL}>GitHub</a>
    <button type="button" class="foot__link" data-ask-open>Cambiar de perfil</button>
  </nav>
</footer>

<script>
  import '../scripts/landing';
</script>
</body>
</html>
